    "properties": {
        "id": {
            "type": "integer",
            "description": "Primary key, auto-increment"
        },
        "title": {
            "type": "string",
            "description": "Book title"
        },
        "author": {
            "type": "string",
            "description": "Book author"
        },
        "subject": {
            "type": "string",
            "description": "Related subject name"
        },
        "description": {
            "type": "string",
            "description": "Brief description of the book"
        },
        "cover_url": {
            "type": "string",
